# Local studio. Copy to .env and set paths relative to the repo or absolute.
STUDIO_TEXT_PROVIDER=ollama
STUDIO_IMAGE_PROVIDER=comfyui
STUDIO_TTS_PROVIDER=piper
STUDIO_LANGUAGE=Russian
STUDIO_REFERENCE=assets/characters/jinhyeok-approved.png
STUDIO_OLLAMA_URL=http://127.0.0.1:11435
STUDIO_OLLAMA_MODEL=qwen3:4b
STUDIO_VISION_MODEL=
STUDIO_COMFY_URL=http://127.0.0.1:8189
STUDIO_COMFY_WORKFLOW=tools/workflows/sdxl-ipadapter.json
STUDIO_COMFY_OUTPUT_NODE=11
STUDIO_COMFY_TRUSTED_NODES=IPAdapterModelLoader,IPAdapterAdvanced
STUDIO_PIPER_EXECUTABLE=
STUDIO_PIPER_PYTHON=.studio-local/piper/Scripts/python.exe
STUDIO_PIPER_MODEL=.studio-local/piper-models/ru_RU-dmitri-medium.onnx
STUDIO_PREPARED_DIR=
